# Google Places API (for Customer Reviews check)
# Get key: https://console.cloud.google.com/
# Enable: Places API, Maps JavaScript API
# Restrict to: Allow all IPs (or set specific IPs for production)
GOOGLE_PLACES_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxx

# Trustpilot API (optional, enriches review data)
# Get credentials: https://developers.trustpilot.com/
# Select: Data Solutions product tier
# Use Bearer token from your Trustpilot developer account
TRUSTPILOT_API_KEY=your_trustpilot_bearer_token_here

# Groq AI API (for sentiment analysis of reviews)
# Get key: https://console.groq.com/keys
# Free tier includes: mixtral-8x7b-32768, llama models
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# Airtable Configuration (optional, for lead storage)
# Get your token: https://airtable.com/account/tokens
# Get your base ID: Open your Airtable base, look in the URL (app/appXXXXXXXX/)
AIRTABLE_TOKEN=pat_xxxxxxxxxxxx
AIRTABLE_BASE_ID=appXXXXXXXX

# Optional: Server port (default: 3000)
PORT=3000
